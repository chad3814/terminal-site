# Copy to .env and fill in. Compose fails fast on the ones marked required
# rather than starting with a guessed value.

# Public hostname nginx-proxy dispatches to this container, and the origin the
# browser will send. Must be the name Authelia protects.
#
# One hostname only. nginx-proxy accepts a comma-separated list, but compose
# builds ALLOWED_ORIGINS as https://$VIRTUAL_HOST, so "a,b" would produce the
# malformed origin "https://a,b" and the server would refuse to start. For
# several hostnames, set ALLOWED_ORIGINS explicitly in docker-compose.yaml.
VIRTUAL_HOST=terminals.chadsho.me

# Peers allowed to open a WebSocket, as a comma-separated CIDR list, checked
# against the TCP peer address. Must contain the nginx-proxy container's
# address on the proxy network:
#
#   docker network inspect config_proxy \
#     -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#
# A malformed entry stops the server at boot rather than being skipped.
TRUSTED_PROXIES=172.18.0.0/16

# Host directory bind-mounted at /work. Any shell in the container can read and
# write everything under it, so keep it narrow: pointing this at /fast/config
# (zeus's compose files and secrets) or at / would hand over the host.
WORK_DIR=/fast/work

# The proxy network as Docker names it. Compose prefixes with the project
# directory, so zeus's /fast/config `proxy` network is `config_proxy`.
# Verify with `docker network ls`.
PROXY_NETWORK=config_proxy

TZ=America/Chicago
